# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

# https://www.runway.team/blog/how-to-set-up-a-ci-cd-pipeline-for-your-ios-app-fastlane-github-actions

default_platform(:ios)

require 'fileutils'
require 'base64'
require 'digest'
require 'find'
require 'open3'
require 'plist'
require 'shellwords'
require 'tempfile'
require 'fastlane_core/cert_checker'

platform :ios do
  desc 'Load ASC API Key information to use in subsequent lanes'
  lane :load_asc_api_key do
    app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_KEY'],
      is_key_content_base64: false,
      in_house: false # Detecting this via ASC private key not currently supported
    )
  end

  desc 'Generate build number based on number of commits'
  lane :generate_build_number do
    # Deterministically set the build number based on the number of commits
    build_number = number_of_commits()

    increment_build_number(
      build_number: build_number
    )
  end

 desc 'Installs signing certificate in the keychain and downloads provisioning profiles from App Store Connect'
 lane :prepare_signing do |options|
   team_id = CredentialsManager::AppfileConfig.try_fetch_value(:team_id)
   api_key = lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
   app_identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
   bundle_identifier = ENV['BUNDLE_ID'] || app_identifier

   keychain_name = 'signing'
   keychain_password = 'temp'

   delete_keychain(
     name: keychain_name
   ) if File.exist? File.expand_path("~/Library/Keychains/#{keychain_name}-db")

   create_keychain(
     name: keychain_name,
     password: keychain_password,
     default_keychain: true,
     unlock: true,
     timeout: 3600
   )

   import_certificate(
     certificate_path: ENV['SIGNING_KEY_FILE_PATH'],
     certificate_password: ENV['SIGNING_KEY_PASSWORD'],
     keychain_name: keychain_name,
     keychain_password: keychain_password
   )

    log_provisioning_profile_diagnostics if options[:log_profile_diagnostics]

    [true, false].each do |adhoc|
      profile_name = adhoc ? 'HackerNews AdHoc Distribution' : 'Github'
      widget_profile_name = adhoc ? 'HackerNews AdHoc HomeWidget' : 'HackerNewsHomeWidget Distribution'
      # Fetches and installs provisioning profiles from ASC
      sigh(
        adhoc: adhoc,
        api_key: api_key,
        readonly: true,
        provisioning_name: profile_name,
        app_identifier: bundle_identifier
      )
      sigh(
        adhoc: adhoc,
        api_key: api_key,
        readonly: true,
        provisioning_name: widget_profile_name,
        app_identifier: 'com.emergetools.hackernews.HackerNewsHomeWidget'
      )
    end
  end

  desc 'Log non-sensitive provisioning profile diagnostics'
  private_lane :log_provisioning_profile_diagnostics do
    app_identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    bundle_identifier = ENV['BUNDLE_ID'] || app_identifier
    identifiers = {
      app: bundle_identifier,
      widget: 'com.emergetools.hackernews.HackerNewsHomeWidget'
    }
    profile_types = [
      Spaceship::ConnectAPI::Profile::ProfileType::IOS_APP_ADHOC,
      Spaceship::ConnectAPI::Profile::ProfileType::IOS_APP_STORE
    ]
    profiles = Spaceship::ConnectAPI::Profile.all(
      filter: { profileType: profile_types.join(',') },
      includes: 'bundleId,certificates'
    ).filter_map do |profile|
      target = identifiers.key(profile.bundle_id&.identifier)
      [target, profile] if target
    end

    if profiles.empty?
      UI.message('Provisioning profile diagnostics: no matching profiles found')
      next
    end

    UI.message('Provisioning profile diagnostics:')
    profiles.sort_by { |target, profile| [target.to_s, profile.name.to_s] }.each do |target, profile|
      matches_installed_certificate = profile.certificates.to_a.any? do |certificate|
        begin
          Tempfile.create('profile-certificate') do |file|
            file.binmode
            file.write(Base64.decode64(certificate.certificate_content))
            file.flush
            FastlaneCore::CertChecker.installed?(file.path)
          end
        rescue StandardError
          false
        end
      end

      UI.message(
        "- target=#{target} name=#{profile.name.inspect} " \
        "type=#{profile.profile_type} state=#{profile.profile_state} " \
        "valid=#{profile.valid?} " \
        "matches_installed_certificate=#{matches_installed_certificate}"
      )
    end
  rescue StandardError => error
    UI.important("Unable to inspect provisioning profiles (#{error.class})")
  end

  desc 'Build the iOS app'
  lane :build_app_for_scheme do |options|
    app_identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    bundle_identifier = ENV['BUNDLE_ID'] || app_identifier

    profile_name = ENV['PROV_PROFILE_NAME'] || 'Github'
    widget_profile_name = ENV['WIDGET_PROV_PROFILE_NAME'] || 'HackerNewsHomeWidget Distribution'
    output_name = 'hackernews-iOS' # .ipa name
    export_method = 'app-store-connect'

    # Turn off automatic signing during build so correct code signing identity is guaranteed to be used
    update_code_signing_settings(
      use_automatic_signing: false,
      targets: ['HackerNews', 'HackerNewsHomeWidgetExtension'],
      code_sign_identity: 'Apple Distribution',
      bundle_identifier: bundle_identifier,
      profile_name: profile_name,
      build_configurations: [ENV['CONFIGURATION']],
      team_id: ENV['APPLE_TEAM_ID']
    )

    # Also update code signing for widget extension specifically
    update_code_signing_settings(
      use_automatic_signing: false,
      targets: ['HackerNewsHomeWidgetExtension'],
      code_sign_identity: 'Apple Distribution',
      bundle_identifier: 'com.emergetools.hackernews.HackerNewsHomeWidget',
      profile_name: widget_profile_name,
      build_configurations: [ENV['CONFIGURATION']],
      team_id: ENV['APPLE_TEAM_ID']
    )

    # build the app
    build_ios_app(
      scheme: 'HackerNews',
      output_name: output_name,
      configuration: ENV['CONFIGURATION'],
      export_team_id: ENV['APPLE_TEAM_ID'],
      skip_package_ipa: true,
      archive_path: './build/HackerNews.xcarchive',
      export_options: {
        method: export_method,
        provisioningProfiles: {
          bundle_identifier => profile_name,
          'com.emergetools.hackernews.HackerNewsHomeWidget' => widget_profile_name
        },
        teamID: ENV['APPLE_TEAM_ID']
      }
    )
  end

  desc 'Upload to TestFlight / ASC'
  lane :upload_app do
    api_key = lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]

    deliver(
      api_key: api_key,
      skip_screenshots: true,
      skip_metadata: true,
      skip_app_version_update: true,
      force: true, # Skips verification of HTML preview file (since this will be run from a CI machine)
      run_precheck_before_submit: false # Not supported through ASC API yet
    )
  end

  desc 'Build, upload to App Store Connect/TestFlight, and upload build metadata to Sentry'
  lane :build_upload_testflight_candidate do
    load_asc_api_key
    prepare_signing
    generate_build_number
    build_app_for_scheme
    upload_app
    sentry_debug_files_upload(
      auth_token: ENV['SENTRY_SENTRY_AUTH_TOKEN'],
      org_slug: 'sentry',
      project_slug: 'hackernews-ios',
      include_sources: true
    )
    sentry_upload_build(
      auth_token: ENV['SENTRY_SENTRY_AUTH_TOKEN'],
      org_slug: 'sentry',
      project_slug: 'hackernews-ios',
      build_configuration: 'Release',
      log_level: 'debug'
    )
  end

  desc 'Build a Release archive and upload a thinned IPA to Sentry for Size Analysis'
  lane :build_upload_sentry_size_analysis do
    load_asc_api_key
    prepare_signing
    build_app_for_scheme
    ipa_path = export_thinned_size_analysis_ipa
    sentry_upload_build(
      auth_token: ENV['SENTRY_SENTRY_AUTH_TOKEN'],
      org_slug: 'sentry',
      project_slug: 'hackernews-ios',
      ipa_path: ipa_path,
      build_configuration: 'Release',
      log_level: 'debug'
    )
  end

  desc 'Export a thinned Release IPA for Sentry Size Analysis'
  private_lane :export_thinned_size_analysis_ipa do |options|
    options ||= {}
    xcarchive_path = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    device_type = options[:device_type] || 'iPhone17,1'
    project_root = File.expand_path('..', __dir__)
    export_dir = File.join(project_root, 'build', 'sentry-size-analysis')
    export_options_path = File.join(project_root, 'build', 'sentry-size-analysis-export-options.plist')

    UI.user_error!('No XCArchive path found for size analysis export') unless xcarchive_path
    xcarchive_path = File.expand_path(xcarchive_path, project_root) unless xcarchive_path.start_with?('/')

    app_identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    bundle_identifier = ENV['BUNDLE_ID'] || app_identifier
    profile_name = 'HackerNews AdHoc Distribution'
    widget_profile_name = 'HackerNews AdHoc HomeWidget'

    export_options = {
      method: 'release-testing',
      thinning: device_type,
      teamID: ENV['APPLE_TEAM_ID'],
      signingStyle: 'manual',
      provisioningProfiles: {
        bundle_identifier => profile_name,
        'com.emergetools.hackernews.HackerNewsHomeWidget' => widget_profile_name
      }
    }

    FileUtils.rm_rf(export_dir)
    FileUtils.mkdir_p(export_dir)
    FileUtils.mkdir_p(File.dirname(export_options_path))
    File.write(export_options_path, Plist::Emit.dump(export_options))

    xcsafe = File.join(Gym::ROOT, 'lib/assets/wrap_xcodebuild/xcbuild-safe.sh')
    sh(
      [
        Shellwords.escape(xcsafe),
        '-exportArchive',
        '-archivePath', Shellwords.escape(xcarchive_path),
        '-exportOptionsPlist', Shellwords.escape(export_options_path),
        '-exportPath', Shellwords.escape(export_dir)
      ].join(' ')
    )

    thinning_plist_path = File.join(export_dir, 'app-thinning.plist')
    # Do not silently upload the universal IPA when Xcode ignores the thinning option.
    UI.user_error!("App thinning report not found in #{export_dir}") unless File.file?(thinning_plist_path)

    plist_data = Plist.parse_xml(thinning_plist_path)
    ipa_path = nil
    plist_data&.fetch('variants', {})&.each do |path, variant|
      descriptors = variant['variantDescriptors'] || []
      next unless descriptors.any? { |descriptor| descriptor['device'] == device_type }

      candidates = [
        path,
        File.join(export_dir, path),
        File.expand_path(path, export_dir)
      ]
      ipa_path = candidates.find { |candidate| File.file?(candidate) }
      break if ipa_path
    end

    UI.user_error!("No thinned IPA found for #{device_type} in #{export_dir}") unless ipa_path

    UI.message("Using thinned IPA for Sentry Size Analysis: #{ipa_path}")
    ipa_path
  end

  desc 'Test App Store and release-testing thinning exports without uploading artifacts'
  lane :test_app_thinning_exports do
    load_asc_api_key
    prepare_signing(log_profile_diagnostics: true)
    build_app_for_scheme

    archive_path = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    UI.user_error!('No XCArchive path found for app thinning experiment') unless archive_path

    project_root = File.expand_path('..', __dir__)
    archive_path = File.expand_path(archive_path, project_root) unless archive_path.start_with?('/')
    experiment_dir = File.join(project_root, 'build', 'app-thinning-experiment')
    summary_path = File.join(experiment_dir, 'summary.md')
    device_type = 'iPhone17,1'
    team_id = ENV['APPLE_TEAM_ID']
    app_identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    bundle_identifier = ENV['BUNDLE_ID'] || app_identifier
    widget_identifier = 'com.emergetools.hackernews.HackerNewsHomeWidget'

    app_store_profiles = {
      bundle_identifier => 'Github',
      widget_identifier => 'HackerNewsHomeWidget Distribution'
    }
    release_testing_profiles = {
      bundle_identifier => 'HackerNews AdHoc Distribution',
      widget_identifier => 'HackerNews AdHoc HomeWidget'
    }

    cases = [
      {
        name: 'app-store-control',
        method: 'app-store-connect',
        thinning: nil,
        provisioning_profiles: app_store_profiles
      },
      {
        name: 'app-store-with-thinning',
        method: 'app-store-connect',
        thinning: device_type,
        provisioning_profiles: app_store_profiles
      },
      {
        name: 'release-universal',
        method: 'release-testing',
        thinning: '<none>',
        provisioning_profiles: release_testing_profiles
      },
      {
        name: 'release-device',
        method: 'release-testing',
        thinning: device_type,
        provisioning_profiles: release_testing_profiles
      },
      {
        name: 'release-device-upload-symbols',
        method: 'release-testing',
        thinning: device_type,
        upload_symbols: true,
        provisioning_profiles: release_testing_profiles
      },
      {
        name: 'release-all-variants',
        method: 'release-testing',
        thinning: '<thin-for-all-variants>',
        provisioning_profiles: release_testing_profiles
      }
    ]

    FileUtils.rm_rf(experiment_dir)
    FileUtils.mkdir_p(experiment_dir)
    xcsafe = File.join(Gym::ROOT, 'lib/assets/wrap_xcodebuild/xcbuild-safe.sh')

    rows = cases.map do |test_case|
      export_dir = File.join(experiment_dir, test_case[:name])
      export_options_path = File.join(experiment_dir, "#{test_case[:name]}.plist")
      export_options = {
        method: test_case[:method],
        teamID: team_id,
        signingStyle: 'manual',
        provisioningProfiles: test_case[:provisioning_profiles]
      }
      export_options[:thinning] = test_case[:thinning] if test_case[:thinning]
      export_options[:uploadSymbols] = test_case[:upload_symbols] unless test_case[:upload_symbols].nil?

      FileUtils.mkdir_p(export_dir)
      File.write(export_options_path, Plist::Emit.dump(export_options))

      started_at = Process.clock_gettime(Process::CLOCK_MONOTONIC)
      _, status = Open3.capture2e(
        xcsafe,
        '-exportArchive',
        '-archivePath', archive_path,
        '-exportOptionsPlist', export_options_path,
        '-exportPath', export_dir
      )
      duration = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started_at

      ipa_paths = Dir.glob(File.join(export_dir, '**', '*.ipa')).sort
      dsym_paths = Dir.glob(File.join(export_dir, '**', '*.dSYM')).select { |path| File.directory?(path) }.sort
      thinning_plist_path = File.join(export_dir, 'app-thinning.plist')
      size_report_path = File.join(export_dir, 'App Thinning Size Report.txt')
      devices = []
      if File.file?(thinning_plist_path)
        plist_data = Plist.parse_xml(thinning_plist_path)
        devices = plist_data&.fetch('variants', {})&.values&.flat_map do |variant|
          (variant['variantDescriptors'] || []).filter_map { |descriptor| descriptor['device'] }
        end || []
      end

      assets_size = nil
      assets_sha = nil
      expanded_size = nil
      if ipa_paths.one?
        extraction_dir = File.join(export_dir, 'extracted')
        unzip_output, unzip_status = Open3.capture2e('unzip', '-q', ipa_paths.first, '-d', extraction_dir)
        File.write(File.join(export_dir, 'unzip.log'), unzip_output)
        if unzip_status.success?
          app_path = Dir.glob(File.join(extraction_dir, 'Payload', '*.app')).first
          if app_path
            assets_path = File.join(app_path, 'Assets.car')
            if File.file?(assets_path)
              assets_size = File.size(assets_path)
              assets_sha = Digest::SHA256.file(assets_path).hexdigest
            end
            expanded_size = 0
            Find.find(app_path) do |path|
              expanded_size += File.size(path) if File.file?(path)
            end
          end
        end
      end

      {
        name: test_case[:name],
        method: test_case[:method],
        thinning: test_case[:thinning] || 'omitted',
        upload_symbols: test_case[:upload_symbols].nil? ? 'omitted' : test_case[:upload_symbols],
        success: status.success?,
        exit_status: status.exitstatus,
        duration: duration,
        ipa_count: ipa_paths.length,
        dsym_count: dsym_paths.length,
        ipa_size: ipa_paths.sum { |path| File.size(path) },
        expanded_size: expanded_size,
        assets_size: assets_size,
        assets_sha: assets_sha,
        thinning_plist: File.file?(thinning_plist_path),
        size_report: File.file?(size_report_path),
        devices: devices.uniq.sort
      }
    end

    by_name = rows.to_h { |row| [row[:name], row] }
    failures = []
    rows.each do |row|
      failures << "#{row[:name]} export failed with status #{row[:exit_status]}" unless row[:success]
    end
    failures << 'App Store control unexpectedly produced a thinning plist' if by_name['app-store-control'][:thinning_plist]
    if by_name['app-store-with-thinning'][:thinning_plist]
      failures << 'App Store export unexpectedly honored the thinning option'
    end
    app_store_assets = [
      by_name['app-store-control'][:assets_sha],
      by_name['app-store-with-thinning'][:assets_sha]
    ]
    if app_store_assets.all? && app_store_assets.uniq.length != 1
      failures << 'App Store control and thinning-request Assets.car hashes differ'
    end
    unless by_name['release-device'][:thinning_plist]
      failures << 'Device release-testing export did not produce a thinning plist'
    end
    unless by_name['release-device'][:devices].include?(device_type)
      failures << "Device release-testing export did not contain #{device_type}"
    end
    unless by_name['release-device-upload-symbols'][:thinning_plist]
      failures << 'Device release-testing export with uploadSymbols did not produce a thinning plist'
    end
    unless by_name['release-device-upload-symbols'][:devices].include?(device_type)
      failures << "Device release-testing export with uploadSymbols did not contain #{device_type}"
    end
    unless by_name['release-all-variants'][:thinning_plist]
      failures << 'All-variants release-testing export did not produce a thinning plist'
    end

    format_bytes = lambda do |bytes|
      bytes ? format('%.2f MB', bytes.to_f / 1_000_000) : 'n/a'
    end
    summary = [
      '# App Thinning Export Experiment',
      '',
      "Archive: `#{File.basename(archive_path)}`",
      '',
      '| Case | Method | Thinning | uploadSymbols | Result | Duration | IPAs | dSYMs | IPA Size | Expanded Size | Assets.car | Thinning Plist | Size Report | Devices |',
      '| --- | --- | --- | --- | --- | ---: | ---: | ---: | ---: | ---: | ---: | --- | --- | --- |'
    ]
    rows.each do |row|
      summary << [
        row[:name],
        row[:method],
        "`#{row[:thinning]}`",
        "`#{row[:upload_symbols]}`",
        row[:success] ? 'passed' : "failed (#{row[:exit_status]})",
        format('%.1fs', row[:duration]),
        row[:ipa_count],
        row[:dsym_count],
        format_bytes.call(row[:ipa_size]),
        format_bytes.call(row[:expanded_size]),
        format_bytes.call(row[:assets_size]),
        row[:thinning_plist] ? 'yes' : 'no',
        row[:size_report] ? 'yes' : 'no',
        row[:devices].join(', ')
      ].join(' | ').then { |values| "| #{values} |" }
    end
    summary << ''
    summary << "App Store Assets.car hashes match: `#{app_store_assets.all? && app_store_assets.uniq.one?}`"
    release_device_assets = [
      by_name['release-device'][:assets_sha],
      by_name['release-device-upload-symbols'][:assets_sha]
    ]
    summary << "release-device Assets.car hashes match with and without uploadSymbols: `#{release_device_assets.all? && release_device_assets.uniq.one?}`"
    summary << ''
    if failures.empty?
      summary << 'All experiment assertions passed.'
    else
      summary << '## Failed Assertions'
      summary << ''
      failures.each { |failure| summary << "- #{failure}" }
    end
    summary << ''
    summary << 'Raw IPAs and provisioning profiles are intentionally not uploaded.'

    File.write(summary_path, summary.join("\n"))
    UI.message(File.read(summary_path))
    UI.user_error!(failures.join('; ')) unless failures.empty?
  end

  desc 'Build an Ad Hoc archive and upload it to Sentry Build Distribution'
  lane :build_upload_sentry_distribution do
    load_asc_api_key
    prepare_signing
    build_app_for_scheme
    sentry_upload_build(
      auth_token: ENV['SENTRY_SENTRY_AUTH_TOKEN'],
      org_slug: 'sentry',
      project_slug: 'hackernews-ios',
      build_configuration: 'AdHoc',
      log_level: 'debug'
    )
  end


  desc 'Upload SnapshotPreviews snapshots to Sentry'
  lane :upload_sentry_snapshots do |options|
    sentry_upload_snapshots(
      path: options[:path],
      app_id: 'com.emergetools.hackernews',
      auth_token: ENV['SENTRY_SENTRY_AUTH_TOKEN'],
      org_slug: 'sentry',
      project_slug: 'hackernews-ios'
    )
  end

  desc 'Upload swift-snapshot-testing snapshots to Sentry'
  lane :upload_sentry_snapshots_swift_snapshot_testing do
    sentry_upload_snapshots(
      path: 'HackerNewsTests/__Snapshots__/SwiftSnapshotTest',
      app_id: 'com.emergetools.hackernews.swift-snapshot-testing',
      auth_token: ENV['SENTRY_SENTRY_AUTH_TOKEN'],
      org_slug: 'sentry',
      project_slug: 'hackernews-ios'
    )
  end

  desc 'Build the iOS app only (no uploads)'
  lane :build_only do
    load_asc_api_key
    prepare_signing
    generate_build_number
    build_app_for_scheme(build_configuration: ENV['CONFIGURATION'] || 'Release')
  end
end
